# Copy this file to ".env" (git-ignored) in the repository root and fill in the
# variables for the provider you use with ai_explain.py. Never commit the real ".env".

# --- provider = openai (default) ---
# AI_EXPLAIN_PROVIDER=openai
# OPENAI_API_KEY=
# AI_EXPLAIN_MODEL=gpt-4o-mini

# --- provider = azure ---
# AI_EXPLAIN_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- provider = github (GitHub Models is being retired, kept for compatibility) ---
# AI_EXPLAIN_PROVIDER=github
# GITHUB_TOKEN=
# AI_EXPLAIN_MODEL=openai/gpt-4o-mini

# --- provider = ollama (fully offline, no token - requires a local Ollama server) ---
AI_EXPLAIN_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_EXPLAIN_MODEL=llama3.1
